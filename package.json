{
  "name": "repforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && powershell -Command \"Copy-Item 'worker\\index.js' -Destination 'dist\\_worker.js' -Force\"",
    "preview": "npm --prefix frontend run preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --commit-dirty=true",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "test": "npm --prefix frontend run test",
    "test:backend": "pytest backend/tests"
  },
  "devDependencies": {
    "wrangler": "^3.114.0 || ^4.0.0"
  }
}
