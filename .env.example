# ============================================================================
# RepForge — Backend Environment Variables Example
#
# Copy this file to .env (or backend/.env) and populate with your real secrets.
# Never commit the real .env file.
# ============================================================================

# --- Flask ---
FLASK_ENV=development                # "production" in production
SESSION_SECRET=your_32_byte_hex_secret_here # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_LIFETIME_SECONDS=604800      # 7 days

# --- Database (Supabase PostgreSQL connection string) ---
# Found in Supabase dashboard: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# --- Gemini AI ---
# Create an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_AI=15 per hour
RATELIMIT_AUTH=20 per hour
RATELIMIT_STORAGE_URI=memory://      # Use redis://... in multi-worker production
